---
import { contact } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Tell me what is not working.',
  body = 'Thirty minutes, shared screens, no pitch deck. Describe the problem — leads that do not convert, ad spend with no return, traffic that never arrived — and I will find the three most expensive leaks while you watch, then tell you honestly whether I am the right person to fix them.',
} = Astro.props;
---

<section class="section section--dark cta" aria-labelledby="cta-heading">
  <div class="container container--narrow cta__inner">
    <p class="eyebrow">Next step</p>
    <h2 id="cta-heading">{heading}</h2>
    <p class="lede">{body}</p>
    <div class="btn-row">
      <a href="/contact/" class="btn btn--primary">Book the free teardown</a>
      <a href={`mailto:${contact.email}`} class="btn btn--ghost">{contact.email}</a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    text-align: center;
  }

  .cta__inner .lede {
    margin-inline: auto;
    margin-top: 1.1rem;
  }

  .cta .btn-row {
    justify-content: center;
  }
</style>
