---
/**
 * The site-wide closing block. This is NOT a sales CTA — it is an open invitation
 * to a conversation. The default copy lives in `chatInvite` in src/data/site.ts
 * so the wording stays identical on every page that uses it.
 */
import { contact, chatInvite } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
}

const { heading = chatInvite.heading, body = chatInvite.body } = Astro.props;
---

<section class="section section--dark cta" aria-labelledby="cta-heading">
  <div class="container container--narrow cta__inner">
    <p class="eyebrow">Say hello</p>
    <h2 id="cta-heading">{heading}</h2>
    <p class="lede">{body}</p>
    <div class="btn-row">
      <a href={`mailto:${contact.email}`} class="btn btn--primary">Email me</a>
      <a href={contact.linkedin} class="btn btn--ghost" rel="noopener">
        Connect on LinkedIn
      </a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    text-align: center;
  }

  .cta__inner .lede {
    margin-inline: auto;
    margin-top: 1.1rem;
  }

  .cta .btn-row {
    justify-content: center;
  }
</style>
