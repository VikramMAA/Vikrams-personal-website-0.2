---
import { site } from '../data/site';

const path = Astro.url.pathname;

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/expertise/', label: 'My expertise' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <span class="brand__name">{site.name}</span>
      <span class="brand__role">{site.jobTitle}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle__label" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <a href="/contact/" class="btn btn--primary">Say hello</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.2;
  }

  .brand__name {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .brand__role {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--text-muted);
    font-weight: 600;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text);
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--accent);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--accent);
  }

  .site-nav__cta a {
    border-bottom: none;
    padding: 0.6rem 1.25rem;
    color: var(--white);
    font-size: 0.9rem;
  }

  .site-nav__cta a:hover {
    color: var(--white);
  }

  /* Mobile menu — CSS only, no JS */
  .nav-toggle,
  .nav-toggle__label {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-toggle__label {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 10px;
      cursor: pointer;
      border-radius: var(--radius-sm);
    }

    .nav-toggle__label span {
      display: block;
      height: 2px;
      background: var(--ink-900);
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .site-nav {
      display: none;
      width: 100%;
      padding-bottom: 1.25rem;
    }

    .nav-toggle:checked ~ .site-nav {
      display: block;
    }

    .nav-toggle:checked ~ .nav-toggle__label span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle:checked ~ .nav-toggle__label span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle:checked ~ .nav-toggle__label span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .site-nav li a {
      display: block;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--border);
    }

    .site-nav__cta {
      margin-top: 0.75rem;
    }

    .site-nav__cta a {
      text-align: center;
      border-bottom: none;
      padding: 0.85rem 1.25rem;
    }
  }
</style>
