---
/**
 * Every page renders through this layout. It owns:
 *  - canonical URL, title, meta description
 *  - Open Graph + Twitter cards
 *  - the site-wide Person / Blog / WebSite JSON-LD
 *  - optional per-page JSON-LD passed in via `schema`
 *
 * There is deliberately no ProfessionalService or OfferCatalog markup here.
 * This is a personal blog and portfolio, not a business offering services.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, contact } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Overrides the derived canonical. Rarely needed. */
  canonical?: string;
  /** Extra JSON-LD objects for this page (Service, FAQPage, Article, etc.). */
  schema?: Record<string, unknown>[];
  /** Set true on pages that should not be indexed. */
  noindex?: boolean;
  /** Relative path to an OG image in /public. */
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  schema = [],
  noindex = false,
  ogImage = '/og-default.png',
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
/**
 * Google truncates the SERP title around 60 characters. Only append the brand
 * suffix when it still fits — a page whose own title is already descriptive is
 * better off without " | Vikram M A A" getting cut off mid-word.
 */
const TITLE_LIMIT = 62;
const withBrand = `${title} | ${site.brand}`;
const fullTitle = title.includes(site.brand)
  ? title
  : withBrand.length <= TITLE_LIMIT
    ? withBrand
    : title;

/**
 * Site-wide identity graph. A Person who writes a Blog — nothing more. The
 * Person and the Blog reference each other inside one @graph.
 */
const identitySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      jobTitle: site.jobTitle,
      email: `mailto:${contact.email}`,
      url: site.url,
      description: `Digital marketing and go-to-market specialist with ${site.yearsExperience}+ years of experience across SEO, performance marketing, social media, content marketing and lead generation. Writes about all of it here.`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: contact.city,
        addressRegion: contact.region,
        addressCountry: contact.countryCode,
      },
      knowsAbout: [
        'Search Engine Optimization',
        'Technical SEO',
        'Performance Marketing',
        'Google Ads',
        'Meta Ads',
        'Social Media Marketing',
        'Content Marketing',
        'Lead Generation',
        'Go-To-Market Strategy',
        'Marketing Analytics',
      ],
      sameAs: contact.socials
        .filter((s) => !s.url.startsWith('mailto:'))
        .map((s) => s.url),
    },
    {
      '@type': 'Blog',
      '@id': `${site.url}/#blog`,
      url: `${site.url}/blog/`,
      name: `${site.name} — notes on digital marketing and GTM`,
      description:
        'Writing on SEO, paid media, organic social, content, lead generation and AI search.',
      author: { '@id': `${site.url}/#person` },
      publisher: { '@id': `${site.url}/#person` },
      inLanguage: 'en',
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: `${site.name} — ${site.jobTitle}`,
      description: site.tagline,
      publisher: { '@id': `${site.url}/#person` },
      inLanguage: 'en',
    },
  ],
};

const allSchema = [identitySchema, ...schema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Google tag (gtag.js) — GA4. `is:inline` keeps it verbatim in the head
        instead of being bundled and deferred by Astro. */}
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3JV22J241M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-3JV22J241M');
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      !noindex && (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <meta name="author" content={site.name} />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content={contact.city} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_IN" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Fonts — preconnect then load without blocking render */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      allSchema.map((s) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(s)}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
