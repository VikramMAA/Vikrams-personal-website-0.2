---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { services } from '../../data/site';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../../data/schema';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: service.title, href: `/services/${service.slug}/` },
];

const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<BaseLayout
  title={service.seoTitle}
  description={service.metaDescription}
  schema={[
    breadcrumbSchema(crumbs),
    serviceSchema({
      name: service.title,
      description: service.summary,
      slug: service.slug,
    }),
    faqSchema(service.faqs),
  ]}
>
  <Breadcrumbs items={crumbs} />

  {/* ------------------------------------------------------------- Header */}
  <section class="section service-hero">
    <div class="container">
      <p class="eyebrow">Service</p>
      <h1>{service.seoTitle.split('—')[0].trim()}</h1>
      <p class="lede">{service.summary}</p>
      <div class="btn-row">
        <a href="/contact/" class="btn btn--primary">Discuss this project</a>
        <a href="/results/" class="btn btn--ghost">See past results</a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ Problem */}
  <section class="section section--alt">
    <div class="container container--narrow">
      <p class="eyebrow">The problem</p>
      <h2>Why this usually is not working already</h2>
      <p class="problem-body">{service.problem}</p>
    </div>
  </section>

  {/* ------------------------------------------------- Deliverables + outcomes */}
  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">What you get</p>
          <h2>Included in the engagement</h2>
          <ul class="checklist">
            {service.deliverables.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <aside class="outcome-panel">
          <h3>What it should produce</h3>
          <ul>
            {service.outcomes.map((item) => <li>{item}</li>)}
          </ul>
          <a href="/contact/" class="btn btn--primary outcome-panel__cta">
            Start with an audit
          </a>
        </aside>
      </div>
    </div>
  </section>

  <FAQ
    items={service.faqs}
    heading={`${service.title} — common questions`}
  />

  {/* ------------------------------------------------------------ Related */}
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Related</p>
        <h2>Often combined with</h2>
      </div>
      <div class="grid grid--3">
        {
          related.map((s) => (
            <a href={`/services/${s.slug}/`} class="card">
              <h3>{s.title}</h3>
              <p>{s.summary}</p>
              <span class="card__link">Explore &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .service-hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(
        ellipse 60% 70% at 85% 0%,
        var(--accent-soft) 0%,
        transparent 62%
      ),
      var(--bg);
  }

  .service-hero h1 {
    max-width: 20ch;
    margin-bottom: 1.35rem;
  }

  .problem-body {
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-muted);
    margin-top: 1.1rem;
    max-width: 64ch;
  }

  .split {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 880px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .split h2 {
    font-size: var(--step-2);
    margin-bottom: 1.75rem;
  }

  .outcome-panel {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    border-radius: var(--radius);
    padding: clamp(1.6rem, 3vw, 2.25rem);
    position: sticky;
    top: 100px;
  }

  @media (max-width: 880px) {
    .outcome-panel {
      position: static;
    }
  }

  .outcome-panel h3 {
    color: var(--text);
    margin-bottom: 1.15rem;
  }

  .outcome-panel ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .outcome-panel li {
    position: relative;
    padding-left: 1.6rem;
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .outcome-panel li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .outcome-panel__cta {
    margin-top: 1.75rem;
    width: 100%;
  }
</style>
