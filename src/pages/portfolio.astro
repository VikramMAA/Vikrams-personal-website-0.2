---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import { site, caseStudies } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const title = 'Portfolio — Digital Marketing Work & Case Studies';
const description = `Selected work by ${site.name}: organic social growth for Mapletree, lead generation for Ayanam Aerospace, and content marketing for MUKA in Canada.`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Portfolio', href: '/portfolio/' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section portfolio-hero">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>The work, and what it produced.</h1>
      <p class="lede">
        Three projects from earlier in my career, across real estate, deep-tech
        manufacturing and an international consumer brand. Different categories, same
        method: audit, define the audience, build the system, then measure against one
        number.
      </p>
    </div>
  </section>

  {
    caseStudies.map((cs, i) => (
      <section
        id={cs.slug}
        class:list={['section', i % 2 === 1 && 'section--alt']}
        aria-labelledby={`${cs.slug}-heading`}
      >
        <div class="container">
          <div class="case">
            <div class="case__head">
              <p class="case__meta">
                {cs.industry} &middot; {cs.location}
              </p>
              <h2 id={`${cs.slug}-heading`}>{cs.client}</h2>
              <p class="case__headline">{cs.headline}</p>
            </div>

            <div class="case__body">
              <div class="case__block">
                <h3>The challenge</h3>
                <p>{cs.challenge}</p>
              </div>

              <div class="case__block">
                <h3>What I did</h3>
                <ul class="checklist">
                  {cs.approach.map((step) => (
                    <li>{step}</li>
                  ))}
                </ul>
              </div>

              <div class="case__block case__block--results">
                <h3>What happened</h3>
                <ul class="results-list">
                  {cs.results.map((r) => (
                    <li>{r}</li>
                  ))}
                </ul>
              </div>
            </div>

            {cs.quote && (
              <blockquote class="case__quote">
                <p>{cs.quote.text}</p>
                <cite>{cs.quote.attribution}</cite>
              </blockquote>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="container container--narrow">
      <div class="disclosure">
        <h2>A note on the numbers</h2>
        <p>
          Percentages on a personal site are easy to inflate, so here is the honest
          framing: the figures above are the outcomes reported during those projects, in
          the categories and time windows described. Marketing results depend on the
          product, the market and the sales team as much as the campaign, and I was one
          input among several. Where a number is vague here, it is because the source was
          vague, not because the rounding flattered me.
        </p>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .portfolio-hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(
        ellipse 60% 70% at 90% 0%,
        var(--accent-soft) 0%,
        transparent 60%
      ),
      var(--bg);
  }

  .portfolio-hero h1 {
    max-width: 16ch;
    margin-bottom: 1.35rem;
  }

  .case__head {
    max-width: 60ch;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .case__meta {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .case__head h2 {
    font-size: var(--step-3);
  }

  .case__headline {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .case__body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: start;
  }

  .case__block h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--ink-900);
  }

  .case__block p {
    color: var(--text-muted);
  }

  .results-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .results-list li {
    position: relative;
    padding-left: 1.6rem;
    font-weight: 500;
  }

  .results-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2.5px solid var(--accent);
  }

  .case__quote {
    margin-top: clamp(2rem, 4vw, 3rem);
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    max-width: 60ch;
  }

  .case__quote p {
    font-size: var(--step-1);
    font-style: italic;
    color: var(--text);
  }

  .case__quote cite {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: normal;
    color: var(--text-muted);
  }

  .disclosure {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--bg-alt);
  }

  .disclosure h2 {
    font-size: var(--step-1);
    margin-bottom: 0.85rem;
  }

  .disclosure p {
    color: var(--text-muted);
  }
</style>
