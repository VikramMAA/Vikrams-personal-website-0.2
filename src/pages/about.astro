---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import { site, contact, topics, industries } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const title = `About ${site.name} — Digital Marketing & GTM, ${contact.city}`;
const description = `${site.name} is a digital marketing and GTM specialist in ${contact.city} with ${site.yearsExperience}+ years across SEO, paid media, social and content. This is his personal site.`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
];

const timeline = [
  {
    period: 'Now',
    title: 'Digital marketing and GTM, full time under contract',
    body: 'Working in-house on go-to-market and digital marketing. Writing here in my own time about the parts of the job worth writing down.',
  },
  {
    period: 'Earlier',
    title: 'Lead generation and content strategy — Ayanam Aerospace',
    body: 'Built the demand generation function for a drone manufacturer selling into a narrow, technical B2B audience.',
  },
  {
    period: 'Earlier',
    title: 'Content marketing — MUKA (Canada)',
    body: 'Defined the brand storyline and content programme for an international art brand, working entirely remotely.',
  },
  {
    period: 'Earlier',
    title: 'Social media strategy — Mapletree',
    body: 'Rebuilt organic social from the audit up, producing a sharp lift in reach, engagement and referral traffic within two months.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section about-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>I have done nearly every job in digital marketing.</h1>
      <p class="lede">
        That is not a boast, it is just how the last {site.yearsExperience} years went.
        SEO, paid media, social, content and lead generation, in agencies, in-house and
        on my own. I have made most of the expensive mistakes already, and this site is
        where I write them down so somebody else does not have to repeat them.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="prose">
          <h2>What this site is</h2>
          <p>
            A blog and a portfolio. The <a href="/blog/">blog</a> is the main thing:
            notes on SEO, paid media, organic social, content and AI search, written for
            the person who has to justify the budget rather than the person selling to
            them. The <a href="/portfolio/">portfolio</a> is a record of work from
            earlier in my career, with the problem, the approach and the outcome for
            each one.
          </p>
          <p>
            To be clear about the thing people usually ask next: I am working full time
            under contract, and I am not taking on freelance or consulting work. Nothing
            here is on sale.
          </p>

          <h2>How I think about marketing</h2>
          <p>
            Diagnose before spending. Before a rupee goes anywhere, look at the site,
            the analytics, the ad accounts, the content and the handover between
            marketing and sales. In most companies that pass finds enough waste to fund
            whatever comes next, and it almost always finds the problem somewhere other
            than where people assumed it was.
          </p>
          <p>
            Then hold the work to one number agreed up front, usually cost per qualified
            lead, sometimes qualified organic traffic or pipeline generated. Reach and
            impressions are diagnostic. They are not the goal, and a report that pretends
            otherwise is just decoration.
          </p>
          <p>
            The <a href="/topics/">topic pages</a> go further into each discipline: what
            usually goes wrong, what actually moves it, and how you know it is working.
          </p>

          <h2>Where I have worked</h2>
          <p>
            National and international, across several verticals — real estate, drone
            manufacturing, art and design, technology and professional services. I have
            worked with a Canadian brand remotely and built lead generation for a
            deep-tech manufacturer in India, which is roughly the range.
          </p>

          <h2>The thing I care most about</h2>
          <p>
            Marketing and sales agreeing on what a qualified lead is. It sounds too small
            to matter. It is the single most common structural problem I have run into,
            and the fix is usually one afternoon in a room with both teams and a
            whiteboard. I have written about it in the <a
              href="/topics/marketing-sales-alignment/">alignment notes</a>.
          </p>

          <h2>Based in {contact.city}</h2>
          <p>
            I am in {contact.city}, {contact.region}. Most of my work has been remote or
            hybrid, across time zones, which is how the Canadian project ran end to end.
          </p>

          <h2>If you want to talk</h2>
          <p>
            I am not available for hire, but I do enjoy the conversation. If you would
            like to know how your GTM or digital marketing issue could be solved, email
            me at <a href={`mailto:${contact.email}`}>{contact.email}</a> or find me
            on <a href={contact.linkedin} rel="noopener">LinkedIn</a>. Happy to have a
            quick chat and think it through with you.
          </p>
        </div>

        <aside class="about-side">
          <div class="side-card">
            <h2 class="side-card__title">At a glance</h2>
            <dl>
              <div>
                <dt>Experience</dt>
                <dd>{site.yearsExperience}+ years in digital marketing</dd>
              </div>
              <div>
                <dt>Based in</dt>
                <dd>{contact.city}, {contact.region}, {contact.country}</dd>
              </div>
              <div>
                <dt>Currently</dt>
                <dd>Working full time under contract</dd>
              </div>
              <div>
                <dt>This site</dt>
                <dd>Personal blog and portfolio</dd>
              </div>
            </dl>
          </div>

          <div class="side-card">
            <h2 class="side-card__title">Topics</h2>
            <ul class="side-list">
              {
                topics.map((t) => (
                  <li>
                    <a href={`/topics/${t.slug}/`}>{t.title}</a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="side-card">
            <h2 class="side-card__title">Industries</h2>
            <p class="side-industries">{industries.join(' \u00b7 ')}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Track record</p>
        <h2>Where the last decade went</h2>
      </div>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <span class="timeline__period">{item.period}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .about-hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(
        ellipse 60% 70% at 10% 0%,
        var(--accent-soft) 0%,
        transparent 60%
      ),
      var(--bg);
  }

  .about-hero h1 {
    max-width: 18ch;
    margin-bottom: 1.35rem;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .about-side {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 100px;
  }

  @media (max-width: 900px) {
    .about-side {
      position: static;
    }
  }

  .side-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    background: var(--bg-alt);
  }

  .side-card__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
  }

  .side-card dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .side-card dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
    font-weight: 600;
  }

  .side-card dd {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
  }

  .side-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .side-list a {
    font-size: 0.95rem;
    text-decoration: none;
    font-weight: 500;
  }

  .side-list a:hover {
    color: var(--accent);
  }

  .side-industries {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .timeline__period {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 700;
    color: var(--accent);
    padding-top: 0.35rem;
  }

  .timeline h3 {
    margin-bottom: 0.4rem;
  }

  .timeline p {
    color: var(--text-muted);
    max-width: 68ch;
  }
</style>
