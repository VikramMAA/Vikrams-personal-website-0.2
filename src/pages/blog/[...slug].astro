---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { articleSchema, breadcrumbSchema } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.published);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/blog/' },
  { label: post.data.title, href: `/blog/${post.id}/` },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  schema={[
    breadcrumbSchema(crumbs),
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      slug: post.id,
      publishedAt: post.data.publishedAt,
      updatedAt: post.data.updatedAt,
    }),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="section">
    <div class="container">
      <header class="post-header">
        <p class="post-meta">
          <time datetime={post.data.publishedAt.toISOString()}>
            {fmt(post.data.publishedAt)}
          </time>
          {
            post.data.updatedAt && (
              <span> &middot; Updated {fmt(post.data.updatedAt)}</span>
            )
          }
          <span> &middot; {site.name}</span>
        </p>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
      </header>

      {
        post.data.heroImage && (
          <img
            class="hero-image"
            src={post.data.heroImage}
            alt={post.data.heroImageAlt ?? post.data.title}
            loading="eager"
            decoding="async"
          />
        )
      }

      <div class="post-body">
        {
          headings.filter((h) => h.depth === 2).length > 2 && (
            <nav class="toc" aria-label="On this page">
              <h2 class="toc__title">On this page</h2>
              <ul>
                {headings
                  .filter((h) => h.depth === 2)
                  .map((h) => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
              </ul>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <CTA />
</BaseLayout>

<style>
  .post-header {
    max-width: 68ch;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }

  .post-meta time {
    color: var(--accent);
  }

  .post-header h1 {
    font-size: var(--step-3);
    margin-bottom: 1.1rem;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 68ch;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .post-body {
    display: grid;
    grid-template-columns: 1fr 15rem;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .post-body {
      grid-template-columns: 1fr;
    }
  }

  .toc {
    order: 2;
    position: sticky;
    top: 100px;
    border-left: 2px solid var(--border);
    padding-left: 1.25rem;
  }

  @media (max-width: 900px) {
    .toc {
      order: -1;
      position: static;
      border-left: none;
      padding-left: 0;
      padding: 1.25rem 1.5rem;
      background: var(--bg-alt);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
  }

  .toc__title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .toc a {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
    line-height: 1.4;
    display: block;
  }

  .toc a:hover {
    color: var(--accent);
  }
</style>
