---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import { site } from '../../data/site';
import { breadcrumbSchema } from '../../data/schema';

const title = 'Insights — Digital Marketing Notes That Are Not Filler';
const description = `Practical writing on SEO, paid media, content and lead generation from ${site.name} — for founders and marketing leads who make the budget call.`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/blog/' },
];

const posts = (await getCollection('blog', ({ data }) => data.published)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  schema={[breadcrumbSchema(crumbs)]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section blog-hero">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>Notes on marketing that has to pay for itself.</h1>
      <p class="lede">
        Written for the person who has to justify the budget. No listicles, no
        "10 tips" — just the reasoning behind the decisions I make in client accounts.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="empty">
            First articles are being written. In the meantime, the
            <a href="/services/"> services pages</a> go into detail on how each channel
            is run.
          </p>
        ) : (
          <ul class="post-list">
            {posts.map((post) => (
              <li>
                <article class:list={['card', post.data.heroImage && 'card--image']}>
                  {post.data.heroImage && (
                    <a
                      class="card__thumb"
                      href={`/blog/${post.id}/`}
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <img
                        src={post.data.heroImage}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  )}
                  <div class="card__body">
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {fmt(post.data.publishedAt)}
                    </time>
                    <h2>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h2>
                    <p>{post.data.description}</p>
                    {post.data.tags.length > 0 && (
                      <ul class="tags">
                        {post.data.tags.slice(0, 4).map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .blog-hero {
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(
        ellipse 60% 70% at 15% 0%,
        var(--accent-soft) 0%,
        transparent 60%
      ),
      var(--bg);
  }

  .blog-hero h1 {
    max-width: 18ch;
    margin-bottom: 1.25rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .post-list li {
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
    border-bottom: 1px solid var(--border);
  }

  .card--image {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  @media (max-width: 700px) {
    .card--image {
      grid-template-columns: 1fr;
    }
  }

  .card__thumb {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .card__thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .post-list time {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--accent);
  }

  .post-list h2 {
    font-size: var(--step-2);
    margin: 0.55rem 0 0.7rem;
    max-width: 26ch;
  }

  .post-list h2 a {
    text-decoration: none;
  }

  .post-list h2 a:hover {
    color: var(--accent);
  }

  .post-list p {
    color: var(--text-muted);
    max-width: 68ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }

  .tags li {
    font-size: 0.78rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .empty {
    color: var(--text-muted);
    font-size: var(--step-1);
    max-width: 55ch;
  }

  .empty a {
    color: var(--accent);
  }
</style>
