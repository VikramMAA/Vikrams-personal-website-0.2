---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import {
  site,
  contact,
  topics,
  stats,
  caseStudies,
  faqs,
  approach,
  industries,
} from '../data/site';
import { faqSchema } from '../data/schema';

const title = `${site.name} — Digital Marketing & GTM Blog and Portfolio`;
const description = `Personal blog and portfolio of ${site.name}, a digital marketing and GTM specialist in ${contact.city} with ${site.yearsExperience}+ years across SEO, paid media, social, content and lead generation.`;

const latestPosts = (await getCollection('blog', ({ data }) => data.published))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={title} description={description} schema={[faqSchema(faqs)]}>
  {/* ---------------------------------------------------------------- Hero */}
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Personal blog &amp; portfolio &middot; {contact.city}, India</p>
      <h1>
        Ten years of digital marketing, <span class="hl">written down</span>.
      </h1>
      <p class="lede">
        I am {site.name}. I have spent {site.yearsExperience}+ years running SEO, paid
        media, social and content for companies across India and North America. This is
        where I write about what worked, what did not, and the work I am proud of.
      </p>
      <div class="btn-row">
        <a href="/blog/" class="btn btn--primary">Read the blog</a>
        <a href="/portfolio/" class="btn btn--ghost">See the work</a>
      </div>
    </div>

    <div class="container">
      <ul class="stats" aria-label="Key figures">
        {
          stats.map((s) => (
            <li>
              <span class="stats__value">{s.value}</span>
              <span class="stats__label">{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------ Latest writing */}
  {
    latestPosts.length > 0 && (
      <section class="section" aria-labelledby="latest-heading">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Latest writing</p>
            <h2 id="latest-heading">Fresh off the keyboard</h2>
            <p>
              Notes for the person who has to justify the budget. No listicles, no
              filler, mostly things I got wrong before I got them right.
            </p>
          </div>

          <div class="grid grid--3">
            {latestPosts.map((post) => (
              <a href={`/blog/${post.id}/`} class="card">
                <p class="card__meta">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {fmt(post.data.publishedAt)}
                  </time>
                </p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="card__link">Read it &rarr;</span>
              </a>
            ))}
          </div>

          <p class="more-link">
            <a href="/blog/">Every post &rarr;</a>
          </p>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------ Problem */}
  <section class="section section--alt" aria-labelledby="problem-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What I keep seeing</p>
        <h2 id="problem-heading">
          Marketing is running. Revenue is not moving.
        </h2>
        <p>
          Almost every company I have worked in or alongside is doing marketing. Posts
          go out, ads run, somebody writes blogs. The problem is that nothing is
          connected, so nobody can say which activity produced which rupee, and the
          budget gets defended rather than directed. Most of what I write here comes out
          of that gap.
        </p>
      </div>

      <div class="grid grid--3">
        <div class="card">
          <h3>Traffic without conversion</h3>
          <p>
            The site gets visitors and nothing happens. Usually the traffic is the wrong
            audience, or the page never asks for anything specific.
          </p>
        </div>
        <div class="card">
          <h3>Ad spend without attribution</h3>
          <p>
            Money goes into Google and Meta every month. Nobody can trace a single closed
            deal back to a campaign, so the budget is a matter of faith.
          </p>
        </div>
        <div class="card">
          <h3>Leads sales will not call</h3>
          <p>
            Marketing reports lead volume, sales says the leads are junk, and both are
            right, because no one agreed what qualified means.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- Topics */}
  <section class="section" aria-labelledby="topics-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Topics</p>
        <h2 id="topics-heading">What I write about</h2>
        <p>
          Six disciplines I have spent a decade inside. Each page collects the pattern I
          keep running into and what actually moves the number.
        </p>
      </div>

      <div class="grid grid--3">
        {
          topics.map((topic) => (
            <a href={`/topics/${topic.slug}/`} class="card">
              <h3>{topic.title}</h3>
              <p>{topic.summary}</p>
              <span class="card__link">Notes on {topic.title} &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- Approach */}
  <section class="section section--alt" aria-labelledby="approach-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How I think about it</p>
        <h2 id="approach-heading">Diagnose first. Spend second.</h2>
        <p>
          The habit that has served me best: never pick a channel before looking at what
          is already running. The audit usually finds enough waste to fund the fix.
        </p>
      </div>

      <ol class="process">
        {
          approach.map((p) => (
            <li>
              <span class="process__step">{p.step}</span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ---------------------------------------------------------- Portfolio */}
  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Portfolio</p>
        <h2 id="work-heading">Work I am proud of</h2>
        <p>
          Across real estate, deep-tech manufacturing and an international consumer
          brand.
        </p>
      </div>

      <div class="grid grid--3">
        {
          caseStudies.map((cs) => (
            <a href={`/portfolio/#${cs.slug}`} class="card">
              <p class="card__meta">
                {cs.industry} &middot; {cs.location}
              </p>
              <h3>{cs.client}</h3>
              <p>{cs.headline}</p>
              <span class="card__link">Read the breakdown &rarr;</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- Industries */}
  <section class="section section--alt" aria-labelledby="industries-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2 id="industries-heading">Categories I have worked in</h2>
        <p>
          The method transfers across categories. What changes is the audience research
          and how long the buying cycle runs.
        </p>
      </div>
      <ul class="tag-list">
        {industries.map((industry) => <li>{industry}</li>)}
      </ul>
    </div>
  </section>

  <FAQ items={faqs} heading="Questions I get asked" />

  <CTA />
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ Hero */
  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) 0;
    background:
      radial-gradient(
        ellipse 70% 60% at 15% 0%,
        var(--accent-soft) 0%,
        transparent 60%
      ),
      var(--bg);
  }

  .hero__inner {
    max-width: 58rem;
  }

  .hero h1 {
    margin-bottom: 1.5rem;
  }

  .hl {
    color: var(--accent);
  }

  /* ----------------------------------------------------------------- Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    list-style: none;
    padding: 0;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--border);
  }

  .stats li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .stats__value {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--ink-900);
  }

  .stats__label {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.4;
    max-width: 22ch;
  }

  /* --------------------------------------------------------------- Process */
  .process {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    counter-reset: none;
  }

  .process li {
    position: relative;
    padding-top: 1.75rem;
    border-top: 2px solid var(--ink-900);
  }

  .process__step {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .process h3 {
    margin-bottom: 0.55rem;
  }

  .process p {
    color: var(--text-muted);
    font-size: 0.96rem;
  }

  /* ------------------------------------------------------------ More link */
  .more-link {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
  }

  .more-link a {
    text-decoration: none;
    color: var(--accent);
  }

  /* ------------------------------------------------------------ Card meta */
  .card__meta {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  /* ------------------------------------------------------------ Tag list */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
  }

  .tag-list li {
    padding: 0.55rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 500;
    background: var(--white);
  }
</style>
