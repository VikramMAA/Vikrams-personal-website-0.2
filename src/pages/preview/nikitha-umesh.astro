    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--nu-accent);
    margin-bottom: 0.5rem;
  }

  /* Calculator */
  .calc-headline {
    font-family: var(--nu-serif);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.25;
    color: var(--nu-brand-dark);
    background: var(--nu-card);
    border-left: 4px solid var(--nu-brand);
    border-radius: 10px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .calc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }

  .calc-card {
    background: var(--nu-card);
    border: 1px solid var(--nu-line);
    border-radius: 14px;
    padding: clamp(1rem, 2.5vw, 1.4rem);
    min-width: 0;
  }

  .calc-card h3 {
    font-size: var(--step-1);
    color: var(--nu-brand);
    margin-bottom: 0.75rem;
  }

  .calc-out {
    position: sticky;
    top: 1rem;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 0.75rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .field--full {
    margin-bottom: 0.25rem;
  }

  .field label {
    font-size: 0.82rem;
    color: var(--nu-muted);
    margin: 0.6rem 0 0.25rem;
    line-height: 1.3;
  }

  .field input {
    width: 100%;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--nu-line);
    border-radius: 9px;
    font: inherit;
    font-size: 1rem;
    background: #fff;
    color: var(--nu-ink);
  }

