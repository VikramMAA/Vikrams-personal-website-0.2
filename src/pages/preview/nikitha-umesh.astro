---
/**
 * Private draft landing page for Chef Nikitha Umesh's two digital products,
 * with a live, client-side pricing and profit calculator. Not a live product.
 *
 * Kept out of search and out of the site's lists, like the other /preview/ pages:
 *  - `noindex` emits <meta name="robots" content="noindex, nofollow">.
 *  - netlify.toml sends `X-Robots-Tag: noindex, nofollow` for /preview/*.
 *  - astro.config.mjs filters /preview/ out of the sitemap (and so IndexNow).
 *  - Nothing on the site links here.
 *
 * There must be no working payment link, form or email capture on this page.
 * Every buy button is an inert, disabled control until checkout is agreed.
 *
 * Calculator defaults are the worked example from the spec and are placeholders,
 * to be refined with Nikitha's real numbers.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const book = {
  price: 'Rs. 499',
  inside: [
    'Core recipes with exact measurements and timings',
    'A technique and troubleshooting note on every recipe (why ganache splits, why the crumb turns dense, why chocolate blooms)',
    'Weather and humidity notes for Indian kitchens',
    'A printable bake-along planner',
    'Substitution and unit-conversion charts',
  ],
  forWho: [
    'Home cooks who follow recipes but want consistent results',
    'Beginners who want to understand why a bake works, not just copy steps',
    'Anyone who bakes for family and festivals and wants to level up',
  ],
  notFor: [
    'Trained or professional pastry chefs who already know the fundamentals',
    'People looking to start a baking business (that is the Business Starter Kit)',
    'Anyone wanting one-to-one coaching or video classes',
  ],
};

const kit = {
  price: 'Rs. 1,499',
  inside: [
    'The Home Baker Pricing and Profit Calculator (the same tool on this page, as a saved copy you own)',
    'A step-by-step start plan: what to do first, second, third',
    'FSSAI home licensing explained in plain language (the licence most home bakers skip, then get caught on)',
    'A sourcing and suppliers guide: where to buy ingredients and packaging at the right price',
    'Packaging and delivery basics that protect your product and your margin',
    'A "first 10 orders" playbook: how to get your first paying customers from people you already know',
    'A costing and order-tracking sheet',
  ],
  forWho: [
    'Stay-at-home parents who want a baking side income',
    'People who already bake and keep being asked "will you make one for me?"',
    'Hobby bakers who want to start selling but do not know how, or what it will cost',
    'Anyone nervous about losing money on a baking venture',
  ],
  notFor: [
    'People who only want to bake for themselves and family (the book is enough)',
    'Established bakeries and trained chefs already running paid operations',
    'Anyone expecting guaranteed income or a done-for-you business',
  ],
};

const credibility = [
  'MasterChef India Telugu judge, the youngest on the India jury',
  'Chocolatier and pastry chef, trained through professional kitchens including ITC Hotels',
  'Co-founder of Naomi Patisserie, Hyderabad, which began as a home venture and grew to multiple outlets',
];

const steps = [
  'Pick your guide: the recipe book, the business kit, or both',
  'Pay once, download instantly',
  'Start baking, or start selling, the same day',
];

const faqs = [
  {
    q: 'Is the recipe book just the free recipes from Instagram?',
    a: 'No. The free posts give you a recipe. The book gives you the technique, the troubleshooting and the planning, so your bakes come out right every time.',
  },
  {
    q: 'I have never sold anything before. Is the Business Kit too advanced?',
    a: 'It is built for exactly that person. It assumes you are starting from zero.',
  },
  {
    q: 'Do I need expensive equipment?',
    a: 'No. Both guides are built around a normal home kitchen.',
  },
];

/** Calculator fields, in spec order. Values are the worked example. */
const fields = [
  { id: 'ing', label: 'Ingredient cost / batch (Rs.)', value: 250 },
  { id: 'units', label: 'Units made / batch', value: 1, min: 1 },
  { id: 'pack', label: 'Packaging / unit (Rs.)', value: 60 },
  { id: 'oh', label: 'Utilities & overhead / unit (Rs.)', value: 40, hint: 'Gas, electricity, equipment wear' },
  { id: 'hrs', label: 'Your time / batch (hours)', value: 2.5, step: 0.5 },
  { id: 'rate', label: 'Your hourly rate (Rs.)', value: 150, hint: 'What your time is worth' },
  { id: 'fail', label: 'Failed-batch rate (%)', value: 12, max: 95, hint: 'How often a bake is wasted' },
  { id: 'del', label: 'Delivery you absorb / order (Rs.)', value: 70 },
  { id: 'fee', label: 'Platform / commission fee (%)', value: 0, max: 95 },
  { id: 'margin', label: 'Profit margin you want (%)', value: 30 },
  { id: 'current', label: 'What you charge now (Rs.)', value: 600 },
  { id: 'orders', label: 'Orders / month', value: 30 },
];
---

<BaseLayout
  title="Draft: Nikitha Umesh digital products"
  description="A draft landing page prepared for Chef Nikitha Umesh. Not a live product."
  noindex={true}
>
  <div class="nu">
    <aside class="draft-bar" aria-label="About this page">
      <strong>Working draft.</strong> Nothing here is on sale yet. Buy buttons are placeholders
      until checkout is set up, and calculator numbers are examples to refine.
    </aside>

    {/* Hero */}
    <section class="nu-hero">
      <div class="nu-wrap nu-wrap--narrow">
        <p class="nu-trust">
          MasterChef India Telugu Judge · Chocolatier · Founder, Naomi Patisserie, Hyderabad
        </p>
        <h1>Bake like you trained in a professional kitchen. From home.</h1>
        <p class="nu-lede">
          Recipes, technique and the business know-how from Chef Nikitha Umesh, MasterChef India
          Telugu judge, chocolatier, and co-founder of Naomi Patisserie.
        </p>
        <div class="nu-ctas">
          <a class="nu-btn nu-btn--primary" href="#guides">See the two guides</a>
          <a class="nu-btn nu-btn--ghost" href="#calculator">Try the pricing calculator</a>
        </div>
      </div>
    </section>

    {/* Calculator: directly after the hero so it is the next thing on mobile */}
    <section id="calculator" class="nu-section nu-section--calc" aria-labelledby="calc-title">
      <div class="nu-wrap">
        <div class="nu-head">
          <p class="nu-eyebrow">Free preview tool</p>
          <h2 id="calc-title">What are you really earning per cake? Most bakers get this wrong.</h2>
          <p>
            Enter your numbers. This is a preview of the full calculator inside the Business
            Starter Kit. Change any field to see the truth about your pricing.
          </p>
        </div>

        <p class="calc-headline" id="r_head" aria-live="polite">&nbsp;</p>

        <div class="calc">
          <form class="calc-card calc-inputs" id="calc-form" onsubmit="return false" novalidate>
            <h3>Your numbers</h3>
            <div class="field field--full">
              <label for="item">Item name</label>
              <input id="item" type="text" value="500g chocolate cake" autocomplete="off" />
            </div>
            <div class="fields">
              {
                fields.map((f) => (
                  <div class="field">
                    <label for={f.id}>{f.label}</label>
                    <input
                      id={f.id}
                      type="number"
                      inputmode="decimal"
                      value={f.value}
                      min={f.min ?? 0}
                      max={f.max}
                      step={f.step ?? 'any'}
                    />
                    {f.hint && <span class="hint">{f.hint}</span>}
                  </div>
                ))
              }
            </div>
          </form>

          <div class="calc-card calc-out">
            <h3>The truth about <span id="o_item">this cake</span></h3>
            <dl class="lines">
              <div class="line"><dt>Cash cost per unit (after wastage)</dt><dd id="o_cash">-</dd></div>
              <div class="line line--time"><dt>Your time per unit</dt><dd id="o_labour">-</dd></div>
              <div class="line"><dt>True cost per unit</dt><dd id="o_true">-</dd></div>
              <div class="line line--price"><dt>Recommended selling price</dt><dd id="o_price">-</dd></div>
              <div class="line"><dt>Profit per unit at that price</dt><dd class="good" id="o_profit">-</dd></div>
              <div class="line"><dt>Monthly profit at recommended price</dt><dd class="good" id="o_month">-</dd></div>
            </dl>

            <div class="reveal">
              <p class="reveal__title">The reality gap at your current price</p>
              <dl class="lines">
                <div class="line"><dt>What you think you earn now</dt><dd id="r_think">-</dd></div>
                <div class="line"><dt>What you actually earn now (with your time)</dt><dd id="r_actual">-</dd></div>
                <div class="line"><dt>The gap, per cake</dt><dd class="bad" id="r_gap">-</dd></div>
                <div class="line"><dt>Left on the table each month</dt><dd class="bad" id="r_table">-</dd></div>
              </dl>
            </div>
            <p class="calc-note">
              The full version inside the Business Starter Kit saves your items and tracks monthly
              profit. <a href="#kit">See the kit</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Products */}
    <section id="guides" class="nu-section" aria-labelledby="guides-title">
      <div class="nu-wrap">
        <div class="nu-head">
          <p class="nu-eyebrow">The two guides</p>
          <h2 id="guides-title">One to bake better. One to start selling.</h2>
        </div>

        <div class="products">
          <article class="product" id="book" aria-labelledby="book-title">
            <p class="product__kicker">Bake It Right</p>
            <h3 id="book-title">The Home Baking Book</h3>
            <p class="product__price">{book.price}</p>
            <p class="product__one">
              Not just recipes. The technique behind them, so your bakes come out right the first
              time.
            </p>
            <p>
              A clean, photographed recipe book covering Nikitha's home baking repertoire: bakes,
              breads and chocolate basics. Every recipe carries exact gram weights, the method, and
              a short "why it works / why it fails" note so you understand the technique, not just
              the steps. Includes a printable bake-along planner and ingredient substitution and
              conversion charts.
            </p>
            <h4>What is inside</h4>
            <ul class="ticks">{book.inside.map((i) => <li>{i}</li>)}</ul>
            <div class="fit">
              <div>
                <h4>Who it is for</h4>
                <ul class="ticks">{book.forWho.map((i) => <li>{i}</li>)}</ul>
              </div>
              <div>
                <h4>Who it is not for</h4>
                <ul class="crosses">{book.notFor.map((i) => <li>{i}</li>)}</ul>
              </div>
            </div>
            <div class="product__buy">
              <button type="button" class="nu-btn nu-btn--primary" disabled aria-disabled="true">
                Get the book for {book.price}
              </button>
              <p class="placeholder">Placeholder button, checkout not connected.</p>
            </div>
          </article>

          <article class="product product--feature" id="kit" aria-labelledby="kit-title">
            <p class="product__kicker">Start Your Home Bakery</p>
            <h3 id="kit-title">The Business Starter Kit</h3>
            <p class="product__price">{kit.price}</p>
            <p class="product__one">
              Everything you need to start selling your bakes, and avoid the costly mistakes that
              sink most home bakers in month one.
            </p>
            <div class="value">
              <p class="value__big">Over Rs. 20,000 of value, for {kit.price}.</p>
              <p>
                Most beginners lose more than that in their first three months by underpricing,
                wasting ingredients, and skipping licensing. This kit is built to stop that.
              </p>
            </div>
            <p>
              A step-by-step plan to go from "I can bake" to "I am taking paid orders", built from
              how Naomi Patisserie itself started as a home venture. It includes the pricing and
              profit calculator, so you know from day one exactly what to charge and what you will
              actually earn.
            </p>
            <h4>What is inside</h4>
            <ul class="ticks">{kit.inside.map((i) => <li>{i}</li>)}</ul>
            <div class="fit">
              <div>
                <h4>Who it is for</h4>
                <ul class="ticks">{kit.forWho.map((i) => <li>{i}</li>)}</ul>
              </div>
              <div>
                <h4>Who it is not for</h4>
                <ul class="crosses">{kit.notFor.map((i) => <li>{i}</li>)}</ul>
              </div>
            </div>
            <div class="product__buy">
              <button type="button" class="nu-btn nu-btn--primary" disabled aria-disabled="true">
                Start your home bakery for {kit.price}
              </button>
              <p class="placeholder">Placeholder button, checkout not connected.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* Credibility */}
    <section class="nu-section nu-section--soft" aria-labelledby="cred-title">
      <div class="nu-wrap nu-wrap--narrow">
        <p class="nu-eyebrow">Who is behind this</p>
        <h2 id="cred-title">Chef Nikitha Umesh</h2>
        <ul class="cred">{credibility.map((c) => <li>{c}</li>)}</ul>
        <p class="cred__proof">
          Her story is the proof. Naomi Patisserie started in a home kitchen. These are the exact
          steps she took.
        </p>
      </div>
    </section>

    {/* How it works */}
    <section class="nu-section" aria-labelledby="how-title">
      <div class="nu-wrap">
        <div class="nu-head">
          <p class="nu-eyebrow">How it works</p>
          <h2 id="how-title">Three steps, no subscriptions</h2>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="steps__num">{i + 1}</span>
                <span>{s}</span>
              </li>
            ))
          }
        </ol>
        <p class="steps__note">No subscriptions. One-time payment. Yours to keep.</p>
      </div>
    </section>

    {/* FAQ */}
    <section class="nu-section nu-section--soft" aria-labelledby="faq-title">
      <div class="nu-wrap nu-wrap--narrow">
        <p class="nu-eyebrow">Questions</p>
        <h2 id="faq-title">Frequently asked</h2>
        <div class="faq">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="nu-section nu-final" aria-labelledby="final-title">
      <div class="nu-wrap nu-wrap--narrow">
        <h2 id="final-title">Start today, from your own kitchen.</h2>
        <div class="nu-ctas">
          <button type="button" class="nu-btn nu-btn--light" disabled aria-disabled="true">
            Get the book ({book.price})
          </button>
          <button type="button" class="nu-btn nu-btn--light" disabled aria-disabled="true">
            Start your home bakery ({kit.price})
          </button>
        </div>
        <p class="bundle">Get both and save. <span>(Bundle price to be confirmed.)</span></p>
        <p class="placeholder placeholder--light">Placeholder buttons, checkout not connected.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Live, client-side calculator. Formula as specified in the landing-page brief.
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const num = (id: string) => {
    const v = parseFloat($(id).value);
    return Number.isFinite(v) ? v : 0;
  };
  const rs = (x: number) => {
    const r = Math.round(x);
    return (r < 0 ? '-Rs. ' : 'Rs. ') + Math.abs(r).toLocaleString('en-IN');
  };
  const set = (id: string, text: string) => {
    $(id).textContent = text;
  };
  // Rates of 100% or more would divide by zero; cap them just below.
  const pct = (id: string) => Math.min(Math.max(num(id), 0), 95) / 100;

  function calc() {
    const ing = num('ing');
    const units = Math.max(num('units'), 1);
    const pack = num('pack');
    const oh = num('oh');
    const hrs = num('hrs');
    const rate = num('rate');
    const fail = pct('fail');
    const del = num('del');
    const fee = pct('fee');
    const margin = Math.max(num('margin'), 0) / 100;
    const current = num('current');
    const orders = Math.max(num('orders'), 0);

    const cashPer = ing / units + pack + oh + del;
    const cashAfterWaste = cashPer / (1 - fail);
    const labour = (hrs * rate) / units;
    const trueCost = cashAfterWaste + labour;
    const priceBeforeFee = trueCost * (1 + margin);
    const price = Math.ceil(priceBeforeFee / (1 - fee) / 10) * 10;
    const profit = price * (1 - fee) - trueCost;

    set('o_cash', rs(cashAfterWaste));
    set('o_labour', rs(labour));
    set('o_true', rs(trueCost));
    set('o_price', rs(price));
    set('o_profit', rs(profit));
    set('o_month', rs(profit * orders));

    const name = $('item').value.trim();
    set('o_item', name || 'this cake');

    // What a beginner usually believes: price minus ingredients.
    const think = current - ing / units;
    // What actually lands after every cost, the platform's cut, and their time.
    const actual = current * (1 - fee) - trueCost;
    const gap = think - actual;
    const onTable = Math.max(price - current, 0) * orders;

    set('r_think', rs(think));
    const a = $('r_actual');
    a.textContent = rs(actual);
    a.className = actual < 0 ? 'bad' : 'good';
    set('r_gap', rs(gap));
    set('r_table', rs(onTable));

    set(
      'r_head',
      actual < 0
        ? `You think you make ${rs(think)} a cake. You are actually losing ${rs(Math.abs(actual))}.`
        : `You think you make ${rs(think)} a cake. After your time, it is really ${rs(actual)}.`,
    );
  }

  document.getElementById('calc-form')?.addEventListener('input', calc);
  calc();
</script>

<style>
  /* Scoped warm palette for this page only. */
  .nu {
    --nu-bg: #fff7f2;
    --nu-card: #ffffff;
    --nu-ink: #2b211c;
    --nu-muted: #7d6c62;
    --nu-line: #ecdfd6;
    --nu-brand: #8d4a2f;
    --nu-brand-dark: #6f3820;
    --nu-soft: #f6e8df;
    --nu-accent: #b5693f;
    --nu-good: #1f7a4d;
    --nu-bad: #c0392b;
    --nu-serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    background: var(--nu-bg);
    color: var(--nu-ink);
  }

  .nu h1,
  .nu h2,
  .nu h3 {
    font-family: var(--nu-serif);
    color: var(--nu-ink);
    letter-spacing: -0.01em;
  }

  .nu-wrap {
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .nu-wrap--narrow {
    max-width: 760px;
  }

  .draft-bar {
    background: var(--nu-ink);
    color: #f3e9e2;
    font-size: var(--step--1);
    text-align: center;
    padding: 0.6rem 16px;
  }

  /* Hero */
  .nu-hero {
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    background:
      radial-gradient(ellipse at top, rgba(181, 105, 63, 0.14), transparent 65%),
      var(--nu-bg);
  }

  .nu-trust {
    display: inline-block;
    font-size: var(--step--1);
    color: var(--nu-brand);
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid var(--nu-line);
    background: var(--nu-card);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.25rem;
  }

  .nu-hero h1 {
    font-size: var(--step-4);
    line-height: 1.08;
  }

  .nu-lede {
    margin: 1.1rem auto 0;
    max-width: 58ch;
    font-size: var(--step-1);
    color: var(--nu-muted);
    line-height: 1.5;
  }

  .nu-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.75rem;
  }

  .nu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: var(--step-0);
    text-decoration: none;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nu-btn--primary {
    background: var(--nu-brand);
    color: #fff;
  }

  .nu-btn--primary:hover {
    background: var(--nu-brand-dark);
  }

  .nu-btn--ghost {
    border-color: var(--nu-brand);
    color: var(--nu-brand);
    background: transparent;
  }

  .nu-btn--ghost:hover {
    background: var(--nu-soft);
  }

  .nu-btn--light {
    background: #fff;
    color: var(--nu-brand-dark);
  }

  .nu-btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .nu-btn--primary:disabled:hover {
    background: var(--nu-brand);
  }

  .placeholder {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--nu-muted);
  }

  .placeholder--light {
    color: rgba(255, 255, 255, 0.75);
  }

  /* Sections */
  .nu-section {
    padding: clamp(2.75rem, 6vw, 4.5rem) 0;
  }

  .nu-section--soft {
    background: var(--nu-soft);
  }

  .nu-section--calc {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .nu-head {
    max-width: 720px;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .nu-head h2,
  .nu-section h2 {
    font-size: var(--step-3);
    line-height: 1.15;
  }

  .nu-head p:not(.nu-eyebrow) {
    margin-top: 0.75rem;
    color: var(--nu-muted);
  }

