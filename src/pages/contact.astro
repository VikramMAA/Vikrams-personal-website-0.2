---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, contact, topics } from '../data/site';
import { breadcrumbSchema } from '../data/schema';

const title = `Contact ${site.name} — Say Hello`;
const description = `Get in touch with ${site.name} by email or LinkedIn. Not available for freelance work, but always happy to talk through a GTM or digital marketing problem.`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: `${site.url}/contact/`,
  mainEntity: { '@id': `${site.url}/#person` },
};
---

<BaseLayout
  title={title}
  description={description}
  schema={[breadcrumbSchema(crumbs), contactPageSchema]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section contact-hero">
    <div class="container">
      <div class="contact-grid">
        {/* ------------------------------------------------------ Left rail */}
        <div>
          <p class="eyebrow">Contact</p>
          <h1>Say hello.</h1>
          <p class="lede">
            A quick note before you write: I am working full time under contract, so I
            am not taking on freelance or consulting work, and this site is not selling
            anything.
          </p>
          <p class="lede">
            That said, if you would like to know how your GTM or digital marketing issue
            could be solved, reach out by email or on LinkedIn. We can have a quick chat
            about how your issue might be resolved. I like these conversations and I
            usually reply within two working days.
          </p>

          <div class="direct">
            <h2 class="direct__title">Two ways to reach me</h2>
            <ul>
              <li>
                <span class="direct__label">Email</span>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </li>
              <li>
                <span class="direct__label">LinkedIn</span>
                <a href={contact.linkedin} rel="noopener">
                  linkedin.com/in/vikram-m-a-a
                </a>
              </li>
              <li>
                <span class="direct__label">Based in</span>
                <span>{contact.city}, {contact.region}, {contact.country}</span>
              </li>
            </ul>
          </div>

          <p class="note">
            If you would rather read than write, the <a href="/blog/">blog</a> and
            the <a href="/topics/">topic notes</a> cover most of what I would say on a
            call anyway.
          </p>
        </div>

        {/* ----------------------------------------------------------- Form */}
        <div class="form-panel">
          <h2 class="form-panel__title">Or use the form</h2>
          <p class="form-intro">
            It lands in the same inbox as the email address. Use whichever is easier.
          </p>

          {/*
            Posts to the Netlify Function in `netlify/functions/contact.mjs`,
            which emails the message through Resend and then redirects — to
            /thank-you/ on success, or back here with #form-error on failure.
            No client-side JavaScript involved. The hidden `bot-field` is the
            spam honeypot.
          */}
          <div class="form-error" id="form-error" role="alert">
            <strong>That did not send.</strong> Something went wrong on my end.
            Please try again, or email me directly at <a
              href={`mailto:${contact.email}`}>{contact.email}</a>.
          </div>

          <form name="hello" method="POST" action="/api/contact">
            <p class="hidden-field">
              <label>
                Do not fill this out if you are human:
                <input name="bot-field" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" type="text" required autocomplete="name" />
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
              />
            </div>

            <div class="field">
              <label for="company">Company <span class="opt">(optional)</span></label>
              <input id="company" name="company" type="text" autocomplete="organization" />
            </div>

            <div class="field">
              <label for="website">Website <span class="opt">(optional)</span></label>
              <input
                id="website"
                name="website"
                type="url"
                placeholder="https://"
                autocomplete="url"
              />
            </div>

            <div class="field">
              <label for="topic">What is this about?</label>
              <select id="topic" name="topic">
                <option value="">Just saying hello</option>
                {topics.map((t) => <option value={t.title}>{t.title}</option>)}
                <option value="Something I wrote">Something I wrote</option>
              </select>
            </div>

            <div class="field">
              <label for="message">What is on your mind?</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="A couple of sentences is plenty. What are you running, and what is it failing to produce?"
              ></textarea>
            </div>

            <button type="submit" class="btn btn--primary form-submit">
              Send message
            </button>

            <p class="form-note">
              No newsletter, no drip sequence. Your details are used only to reply.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-hero h1 {
    font-size: var(--step-3);
    max-width: 16ch;
    margin-bottom: 1.25rem;
  }

  /* Two stacked ledes on this page — .lede carries no margin of its own. */
  .contact-hero .lede + .lede {
    margin-top: 1rem;
  }

  .direct {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .direct__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .direct ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .direct li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  @media (max-width: 420px) {
    .direct li {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .direct__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--accent);
  }

  .direct a {
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--border);
  }

  .direct a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .note {
    margin-top: 1.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 46ch;
  }

  .note a {
    color: var(--accent);
  }

  /* ----------------------------------------------------------------- Form */
  .form-panel {
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .form-panel__title {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }

  .form-intro {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .hidden-field {
    display: none;
  }

  /*
    Hidden until the form handler redirects to /contact/#form-error, at which
    point :target matches. Pure CSS — keeps the page free of runtime JS.
  */
  .form-error {
    display: none;
    margin-bottom: 1.5rem;
    padding: 0.9rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.5;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .form-error:target {
    display: block;
  }

  .form-error a {
    overflow-wrap: anywhere;
  }

  .field {
    margin-bottom: 1.15rem;
  }

  .field label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .opt {
    font-weight: 400;
    color: var(--text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: inherit;
    font-size: 0.97rem;
    color: var(--text);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 7rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .form-submit {
    width: 100%;
    margin-top: 0.5rem;
  }

  .form-note {
    margin-top: 1rem;
    font-size: 0.83rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>
