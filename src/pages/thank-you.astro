---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';

const isProd = import.meta.env.PROD;
---

<BaseLayout
  title="Thank you — your message has been sent"
  description="Your message has been received. I read everything and usually reply within two working days."
  noindex={true}
>
  <section class="section centered">
    <div class="container container--narrow">
      <p class="eyebrow">Received</p>
      <h1>Got it — thank you.</h1>
      <p class="lede">
        Your message has landed. I read everything personally and usually reply within
        two working days.
      </p>
      <p class="lede">
        If it is quicker to talk, call or WhatsApp me on <a
          href={`tel:${contact.phoneRaw}`}>{contact.phone}</a>. You can also find me
        on <a href={contact.linkedin} rel="noopener">LinkedIn</a>.
      </p>
      <div class="btn-row">
        <a href="/blog/" class="btn btn--primary">Read something while you wait</a>
        <a href="/" class="btn btn--ghost">Back to home</a>
      </div>
    </div>
  </section>

  {/*
    GA4 conversion signal for the contact form.

    This page is only reached by the /api/contact handler redirecting here, and
    only the confirmed-success redirect appends ?src=contact — the spam honeypot
    redirect deliberately does not. Keying the event on that parameter means
    generate_lead counts real, server-confirmed submissions: a bot caught by the
    honeypot, or anyone who simply navigates to /thank-you/ directly, fires
    nothing. Do not make this fire unconditionally on page load.

    The newsletter form has its own success page at /subscribed/ and fires
    sign_up rather than generate_lead. A subscriber is not a lead, and the two
    events stay separate on purpose.

    `lead_source` and `form_id` need registering as custom dimensions in GA4
    before they show up in reports (implementation plan, task 1.4).
  */}
  {
    isProd && (
      <script is:inline>
        (function () {
          if (typeof window.gtag !== 'function') return;
          var src = new URLSearchParams(window.location.search).get('src');
          if (!src) return;

          window.gtag('event', 'generate_lead', {
            lead_source: 'contact_form',
            form_id: src,
          });
        })();
      </script>
    )
  }
</BaseLayout>

<style>
  .centered {
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .centered .lede {
    margin-inline: auto;
    margin-top: 1.25rem;
  }

  .centered .btn-row {
    justify-content: center;
  }

  /*
    Scoped to the paragraph links on purpose. A bare `.centered a` also hits the
    buttons in .btn-row, and painting a primary button's text --accent makes it
    invisible against its --accent background.
  */
  .centered .lede a {
    color: var(--accent);
  }
</style>
