---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---

<BaseLayout
  title="Thank you — your message has been sent"
  description="Your message has been received. I read everything and usually reply within two working days."
  noindex={true}
>
  <section class="section centered">
    <div class="container container--narrow">
      <p class="eyebrow">Received</p>
      <h1>Got it — thank you.</h1>
      <p class="lede">
        Your message has landed. I read everything personally and usually reply within
        two working days.
      </p>
      <p class="lede">
        If it is quicker to talk, call or WhatsApp me on <a
          href={`tel:${contact.phoneRaw}`}>{contact.phone}</a>. You can also find me
        on <a href={contact.linkedin} rel="noopener">LinkedIn</a>.
      </p>
      <div class="btn-row">
        <a href="/blog/" class="btn btn--primary">Read something while you wait</a>
        <a href="/" class="btn btn--ghost">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .centered {
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }

  .centered .lede {
    margin-inline: auto;
    margin-top: 1.25rem;
  }

  .centered .btn-row {
    justify-content: center;
  }

  /*
    Scoped to the paragraph links on purpose. A bare `.centered a` also hits the
    buttons in .btn-row, and painting a primary button's text --accent makes it
    invisible against its --accent background.
  */
  .centered .lede a {
    color: var(--accent);
  }
</style>
