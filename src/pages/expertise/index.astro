---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTA from '../../components/CTA.astro';
import { site, expertise } from '../../data/site';
import { breadcrumbSchema } from '../../data/schema';

const title = 'My Expertise — SEO, AISEO, Ads, Social, Content & Leads';
const description = `The disciplines ${site.name} writes about: SEO, performance marketing, social media, content marketing, lead generation, and marketing and sales alignment.`;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'My expertise', href: '/expertise/' },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Digital marketing expertise',
  itemListElement: expertise.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    description: t.summary,
    url: `${site.url}/expertise/${t.slug}/`,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  schema={[breadcrumbSchema(crumbs), itemList]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">My expertise</p>
        <h1>What I write about</h1>
        <p>
          Seven disciplines I have spent ten years inside. Each page is a set of notes:
          the pattern I keep running into, what actually moves the number, and how you
          know it is working. Opinions, not offers.
        </p>
      </div>

      <div class="area-list">
        {
          expertise.map((area, i) => (
            <article class="expertise-row">
              <div class="expertise-row__index">
                {String(i + 1).padStart(2, '0')}
              </div>
              <div class="expertise-row__body">
                <h2>
                  <a href={`/expertise/${area.slug}/`}>{area.title}</a>
                </h2>
                <p class="expertise-row__summary">{area.summary}</p>
                <ul class="expertise-row__tags">
                  {area.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <a class="card__link" href={`/expertise/${area.slug}/`}>
                  Notes on {area.title} &rarr;
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .area-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .expertise-row {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .expertise-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }

  .expertise-row__index {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding-top: 0.45rem;
  }

  .expertise-row h2 {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .expertise-row h2 a {
    text-decoration: none;
  }

  .expertise-row h2 a:hover {
    color: var(--accent);
  }

  .expertise-row__summary {
    color: var(--text-muted);
    font-size: var(--step-0);
    max-width: 62ch;
  }

  .expertise-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.15rem;
  }

  .expertise-row__tags li {
    font-size: 0.82rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
</style>
