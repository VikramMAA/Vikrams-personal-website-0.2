# Contact form (Resend)
#
# Copy this file to `.env` for local testing with `npx netlify dev`.
# In production these live in Netlify → Site configuration → Environment variables.
# `.env` is gitignored — never commit real keys.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified at https://resend.com/domains,
# otherwise Resend rejects the send. Use the display-name form so the email
# reads properly in the inbox.
CONTACT_FROM_EMAIL="Vikram M A A Website <website@vikramaa.com>"

# Where enquiries are delivered. Optional — defaults to the address in
# netlify/functions/contact.mjs.
CONTACT_TO_EMAIL=vikram.1996523@gmail.com
